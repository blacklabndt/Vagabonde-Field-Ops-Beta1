# Supabase CLI scratch: which project this checkout is linked to, cached
# server versions, and the pg-delta working directory. Machine-local state,
# regenerated by `supabase link` — not part of the project.
.temp/
.branches/

# Secrets staged for `supabase secrets set --env-file` (see "Things to do to
# get set up"). Never committed — the whole point of the file is keeping the
# Postmark token out of shell history, not moving it into git history.
.env.secrets
