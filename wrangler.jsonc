{
  // Cloudflare Workers deploy config.
  //
  // In the prototype repo this lived two levels above the project because
  // the Workers Git integration has no root-directory field. Beta1 IS the
  // repo root, so the config lives where it belongs: beside the code.
  //
  // `name` must match the existing Worker, or `wrangler deploy` creates a
  // second one on a new URL and the old address carries on serving the last
  // hand-uploaded build.
  "name": "solitary-snowflake-ee22",
  "compatibility_date": "2026-08-14",

  // A script, not assets alone: /approve has to be served by code. See
  // worker/index.js — Supabase forces text/plain on any HTML an edge function
  // returns from the shared functions domain, so the client's approval page
  // arrived as source rather than as a page. This re-serves it as HTML from a
  // domain we control. Everything else still falls through to the static app.
  "main": "./worker/index.js",

  "assets": {
    "directory": "./vite-app/dist",

    // Named so the Worker can hand non-/approve requests straight back to the
    // asset server: with `main` set, assets are no longer served implicitly.
    "binding": "ASSETS",

    // Without this the approval route silently does not exist. The asset
    // server answers before the Worker script runs, and `single-page-
    // application` below means every *navigation* matches index.html — so
    // /approve returned the app's sign-in screen while a fetch() of the same
    // URL correctly reached the Worker. Only a browser navigating there shows
    // it, which is exactly what a client rep does.
    "run_worker_first": ["/approve", "/approve-ticket"],

    // The app is a single page: every screen is state, not a route, and the
    // service worker already falls back to index.html for navigations. This
    // is the server-side half of that — without it, a hard refresh on any
    // path that isn't a real file returns a 404 instead of the app.
    "not_found_handling": "single-page-application"
  }
}
